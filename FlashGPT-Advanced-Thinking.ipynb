       "## Memory Optimization Techniques\n",
       "\n",
       "This section implements memory-efficient operations for handling large models and contexts:\n",
       "- Chunked matrix multiplication breaks large operations into manageable pieces\n",
       "- KV caching for efficient inference with repeated contexts\n",
       "- Gradient checkpointing for reduced memory during training"
      ]
     },
     {
      "cell_type": "code",
      "execution_count": null,
      "id": "custom-functions",
      "metadata": {},
      "outputs": [],
      "source": [
       "# Helper function: Chunked matrix multiplication\n",
       "def chunked_matmul(a: torch.Tensor, b: torch.Tensor, chunk_size: int = 64) -> torch.Tensor:\n",
       "    \"\"\"\n",
       "    Computes batched matrix multiplication between tensors 'a' and 'b' in smaller chunks.\n",
       "    This helps reduce peak memory usage when computing attention scores.\n",
       "    \n",
       "    a: Tensor of shape (B, n_heads, T, head_dim)\n",
       "    b: Tensor of shape (B, n_heads, head_dim, T)\n",
       "    chunk_size: Number of tokens (T dimension) to process in one chunk.\n",
       "    \n",
       "    Returns:\n",
       "        A tensor of shape (B, n_heads, T, T) computed by processing the T dimension in chunks.\n",
       "    \"\"\"\n",
       "    B, n_heads, T, head_dim = a.shape\n",
       "    output_chunks = []\n",
       "    # Process the T dimension of 'a' in chunks to avoid large intermediate tensors.\n",
       "    for start in range(0, T, chunk_size):\n",
       "        end = min(start + chunk_size, T)\n",
       "        # Compute partial attention scores for the chunk\n",
       "        chunk_result = torch.matmul(a[:, :, start:end, :], b)  # (B, n_heads, chunk_size, T)\n",
       "        output_chunks.append(chunk_result)\n",
       "    return torch.cat(output_chunks, dim=2)\n",
       "\n",
       "# KV Cache for efficient inference\n",
       "class KVCache:\n",
       "    def __init__(self, max_batch_size, max_seq_len, n_heads, head_dim):\n",
       "        self.max_batch_size = max_batch_size\n",
       "        self.max_seq_len = max_seq_len\n",
       "        self.n_heads = n_heads\n",
       "        self.head_dim = head_dim\n",
       "        \n",
       "        # Initialize empty cache\n",
       "        self.k_cache = torch.zeros(max_batch_size, n_heads, max_seq_len, head_dim)\n",
       "        self.v_cache = torch.zeros(max_batch_size, n_heads, max_seq_len, head_dim)\n",
       "        self.current_seq_len = 0\n",
       "        self.initialized = False\n",
       "        \n",
       "    def update(self, k: torch.Tensor, v: torch.Tensor, position: int = None):\n",
       "        \"\"\"\n",
       "        Update the KV cache with new key-value pairs.\n",
       "        \n",
       "        Args:\n",
       "            k: Key tensor of shape (B, n_heads, T, head_dim)\n",
       "            v: Value tensor of shape (B, n_heads, T, head_dim)\n",
       "            position: Position index to update (None for appending)\n",
       "        \"\"\"\n",
       "        if not self.initialized:\n",
       "            # Move cache to the same device as inputs if not initialized\n",
       "            self.k_cache = self.k_cache.to(k.device)\n",
       "            self.v_cache = self.v_cache.to(v.device)\n",
       "            self.initialized = True\n",
       "            \n",
       "        B, n_heads, T, head_dim = k.shape\n",
       "        if position is None:\n",
       "            # Append to the end\n",
       "            position = self.current_seq_len\n",
       "            new_seq_len = position + T\n",
       "            if new_seq_len <= self.max_seq_len:\n",
       "                self.k_cache[:B, :, position:new_seq_len] = k\n",
       "                self.v_cache[:B, :, position:new_seq_len] = v\n",
       "                self.current_seq_len = new_seq_len\n",
       "            else:\n",
       "                raise ValueError(f\"Cannot append {T} tokens. Cache would exceed max_seq_len of {self.max_seq_len}\")\n",
       "        else:\n",
       "            # Update at a specific position\n",
       "            end_position = position + T\n",
       "            if end_position <= self.max_seq_len:\n",
       "                self.k_cache[:B, :, position:end_position] = k\n",
       "                self.v_cache[:B, :, position:end_position] = v\n",
       "                self.current_seq_len = max(self.current_seq_len, end_position)\n",
       "            else:\n",
       "                raise ValueError(f\"Cannot update at position {position} with {T} tokens. Would exceed max_seq_len.\")\n",
       "    \n",
       "    def get(self, start: int = 0, end: int = None):\n",
       "        \"\"\"\n",
       "        Retrieve key-value pairs from the cache.\n",
       "        \n",
       "        Args:\n",
       "            start: Start position (inclusive)\n",
       "            end: End position (exclusive), defaults to current_seq_len\n",
       "            \n",
       "        Returns:\n",
       "            Tuple of (k_cache, v_cache) for the specified range\n",
       "        \"\"\"\n",
       "        if end is None:\n",
       "            end = self.current_seq_len\n",
       "            \n",
       "        return self.k_cache[:, :, start:end], self.v_cache[:, :, start:end]\n",
       "    \n",
       "    def reset(self):\n",
       "        \"\"\"\n",
       "        Reset the cache to its initial state.\n",
       "        \"\"\"\n",
       "        if self.initialized:\n",
       "            self.k_cache.zero_()\n",
       "            self.v_cache.zero_()\n",
       "        self.current_seq_len = 0"
      ]
     },
