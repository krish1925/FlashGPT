      "source": [
       "## Advanced Attention Mechanisms\n",
       "\n",
       "This section implements several advanced attention variants:\n",
       "- Traditional multi-head attention with memory optimizations\n",
       "- Grouped-Query Attention (GQA) for more efficient K/V handling\n",
       "- RWKV-style linear attention for efficient sequence processing"
      ]
     },
     {
      "cell_type": "code",
      "execution_count": null,
      "id": "attention-mechanisms",
      "metadata": {},
      "outputs": [],
      "source": [
       "# --- MultiHeadSelfAttention with Chunked Matmul --- #\n",
       "class MultiHeadSelfAttention(nn.Module):\n",
       "    def __init__(self, config: GPTConfig):\n",
       "        super().__init__()\n",
       "        self.n_head = config.n_head\n",
       "        self.n_embd = config.n_embd\n",
       "        assert self.n_embd % self.n_head == 0, \"Embedding dim must be divisible by number of heads\"\n",
       "        self.head_dim = self.n_embd // self.n_head\n",
       "        \n",
       "        self.q_proj = nn.Linear(self.n_embd, self.n_embd)\n",
       "        self.k_proj = nn.Linear(self.n_embd, self.n_embd)\n",
       "        self.v_proj = nn.Linear(self.n_embd, self.n_embd)\n",
       "        self.out_proj = nn.Linear(self.n_embd, self.n_embd)\n",
       "        self.dropout = nn.Dropout(config.dropout_prob)\n",
       "        self.flash_attention = config.flash_attention\n",
       "        self.use_rope = config.use_rope\n",
       "        \n",
       "        if self.use_rope:\n",
       "            self.rope = RotaryPositionEmbeddings(self.head_dim, config.max_seq_len)\n",
       "        \n",
       "        # Precompute a causal mask for self-attention (upper triangular is masked)\n",
       "        self.register_buffer(\"causal_mask\", torch.tril(torch.ones(config.max_seq_len, config.max_seq_len)), persistent=False)\n",
       "        \n",
       "        # KV cache for efficient inference\n",
       "        self.kv_cache = None\n",
       "\n",
       "    def forward(self, x: torch.Tensor, attention_mask: torch.Tensor = None, alibi_bias: torch.Tensor = None, \n",
       "                use_cache: bool = False, position_ids: torch.LongTensor = None) -> torch.Tensor:\n",
       "        B, T, C = x.size()\n",
       "        q = self.q_proj(x)\n",
       "        k = self.k_proj(x)\n",
       "        v = self.v_proj(x)\n",
       "\n",
       "        # Reshape for multi-head attention\n",
       "        q = q.view(B, T, self.n_head, self.head_dim).transpose(1, 2)\n",
       "        k = k.view(B, T, self.n_head, self.head_dim).transpose(1, 2)\n",
       "        v = v.view(B, T, self.n_head, self.head_dim).transpose(1, 2)\n",
       "        \n",
       "        # Apply RoPE if enabled\n",
       "        if self.use_rope:\n",
       "            q, k = self.rope(q, k, T)\n",
       "        \n",
       "        # Use KV cache during inference if requested\n",
       "        if use_cache:\n",
       "            if self.kv_cache is None:\n",
       "                # Initialize cache if it doesn't exist\n",
       "                self.kv_cache = KVCache(B, 2048, self.n_head, self.head_dim)\n",
       "                self.kv_cache.update(k, v)\n",
       "            else:\n",
       "                # Update cache with new tokens\n",
       "                if position_ids is not None:\n",
       "                    # Update at specific positions\n",
       "                    self.kv_cache.update(k, v, position_ids[0].item())\n",
       "                else:\n",
       "                    # Append to the end\n",
       "                    self.kv_cache.update(k, v)\n",
       "                \n",
       "                # Get the full KV sequence from cache for attention\n",
       "                k, v = self.kv_cache.get()\n",
       "\n",
       "        if self.flash_attention and alibi_bias is None and attention_mask is None and hasattr(F, 'scaled_dot_product_attention'):\n",
       "            # Leverage PyTorch's efficient scaled dot-product implementation when conditions allow.\n",
       "            attn_output = F.scaled_dot_product_attention(q, k, v, dropout_p=self.dropout.p, is_causal=True)\n",
       "        else:\n",
       "            # Compute attention scores in chunks to be memory efficient.\n",
       "            attn_scores = chunked_matmul(q, k.transpose(-2, -1), chunk_size=64) / math.sqrt(self.head_dim)\n",
       "            \n",
       "            # Apply the causal mask (ensures autoregressive property)\n",
       "            seq_len = attn_scores.size(-1)\n",
       "            causal_mask = self.causal_mask[:seq_len, :seq_len]\n",
       "            attn_scores = attn_scores.masked_fill(causal_mask == 0, float('-inf'))\n",
       "            \n",
       "            # Apply ALiBi bias if provided\n",
       "            if alibi_bias is not None:\n",
       "                attn_scores = attn_scores + alibi_bias[:, :, :seq_len]\n",
       "                \n",
       "            # Apply attention mask if provided\n",
       "            if attention_mask is not None:\n",
       "                extended_mask = attention_mask.unsqueeze(1).unsqueeze(2)\n",
       "                attn_scores = attn_scores.masked_fill(extended_mask == 0, float('-inf'))\n",
       "                \n",
       "            attn_weights = F.softmax(attn_scores, dim=-1)\n",
       "            attn_weights = self.dropout(attn_weights)\n",
       "            attn_output = torch.matmul(attn_weights, v)\n",
       "\n",
       "        # Combine heads back together\n",
       "        attn_output = attn_output.transpose(1, 2).contiguous().view(B, T, C)\n",
       "        output = self.out_proj(attn_output)\n",
       "        return self.dropout(output)\n",
       "    \n",
       "    def reset_cache(self):\n",
       "        \"\"\"Reset the KV cache\"\"\"\n",
       "        if self.kv_cache is not None:\n",
       "            self.kv_cache.reset()\n",
       "\n",
       "# --- Grouped-Query Attention (GQA) --- #\n",
       "class GroupedQueryAttention(nn.Module):\n",
       "    def __init__(self, config: GPTConfig):\n",
       "        super().__init__()\n",
       "        self.n_head = config.n_head\n",
       "        self.n_embd = config.n_embd\n",
       "        self.head_dim = self.n_embd // self.n_head\n",
       "        self.n_kv_head = config.n_kv_heads\n",
       "        assert self.n_head % self.n_kv_head == 0, \"n_head must be divisible by n_kv_head\"\n",
       "        \n",
       "        self.q_proj = nn.Linear(self.n_embd, self.n_embd)\n",
       "        self.k_proj = nn.Linear(self.n_embd, self.n_kv_head * self.head_dim)\n",
       "        self.v_proj = nn.Linear(self.n_embd, self.n_kv_head * self.head_dim)\n",
       "        self.out_proj = nn.Linear(self.n_embd, self.n_embd)\n",
       "        self.dropout = nn.Dropout(config.dropout_prob)\n",
       "        self.flash_attention = config.flash_attention\n",
       "        self.use_rope = config.use_rope\n",
       "        \n",
       "        if self.use_rope:\n",
       "            self.rope = RotaryPositionEmbeddings(self.head_dim, config.max_seq_len)\n",
       "        \n",
       "        # Precompute a causal mask for self-attention (upper triangular is masked)\n",
       "        self.register_buffer(\"causal_mask\", torch.tril(torch.ones(config.max_seq_len, config.max_seq_len)), persistent=False)\n",
       "        \n",
       "        # KV cache for efficient inference\n",
       "        self.kv_cache = None\n",
       "        \n",
       "    def forward(self, x: torch.Tensor, attention_mask: torch.Tensor = None, alibi_bias: torch.Tensor = None,\n",
       "                use_cache: bool = False, position_ids: torch.LongTensor = None) -> torch.Tensor:\n",
       "        B, T, C = x.size()\n",
       "        \n",
       "        # Project queries, keys, and values\n",
       "        q = self.q_proj(x).view(B, T, self.n_head, self.head_dim).transpose(1, 2)  # [B, n_head, T, head_dim]\n",
       "        k = self.k_proj(x).view(B, T, self.n_kv_head, self.head_dim).transpose(1, 2)  # [B, n_kv_head, T, head_dim]\n",
       "        v = self.v_proj(x).view(B, T, self.n_kv_head, self.head_dim).transpose(1, 2)  # [B, n_kv_head, T, head_dim]\n",
       "        \n",
       "        # Apply RoPE if enabled\n",
       "        if self.use_rope:\n",
       "            # Apply to q and k from different projections\n",
       "            q_rope = q.reshape(B * self.n_head, T, self.head_dim)\n",
       "            k_rope = k.reshape(B * self.n_kv_head, T, self.head_dim)\n",
       "            q_rope, k_rope = self.rope(q_rope, k_rope, T)\n",
       "            q = q_rope.reshape(B, self.n_head, T, self.head_dim)\n",
       "            k = k_rope.reshape(B, self.n_kv_head, T, self.head_dim)\n",
       "        \n",
       "        # Use KV cache during inference if requested\n",
       "        if use_cache:\n",
       "            if self.kv_cache is None:\n",
       "                # Initialize cache if it doesn't exist\n",
       "                self.kv_cache = KVCache(B, 2048, self.n_kv_head, self.head_dim)\n",
       "                self.kv_cache.update(k, v)\n",
       "            else:\n",
       "                # Update cache with new tokens\n",
       "                if position_ids is not None:\n",
       "                    # Update at specific positions\n",
       "                    self.kv_cache.update(k, v, position_ids[0].item())\n",
       "                else:\n",
       "                    # Append to the end\n",
       "                    self.kv_cache.update(k, v)\n",
       "                \n",
       "                # Get the full KV sequence from cache for attention\n",
       "                k, v = self.kv_cache.get()\n",
       "        \n",
       "        # Expand k and v for multi-query attention (repeat for each query head group)\n",
       "        heads_per_kv = self.n_head // self.n_kv_head\n",
       "        k_expanded = k.unsqueeze(2).expand(B, self.n_kv_head, heads_per_kv, k.size(2), self.head_dim)\n",
       "        v_expanded = v.unsqueeze(2).expand(B, self.n_kv_head, heads_per_kv, v.size(2), self.head_dim)\n",
       "        k = k_expanded.reshape(B, self.n_head, k.size(2), self.head_dim)\n",
       "        v = v_expanded.reshape(B, self.n_head, v.size(2), self.head_dim)\n",
       "        \n",
       "        if self.flash_attention and alibi_bias is None and attention_mask is None and hasattr(F, 'scaled_dot_product_attention'):\n",
       "            # Use PyTorch's efficient implementation when available\n",
       "            attn_output = F.scaled_dot_product_attention(q, k, v, dropout_p=self.dropout.p, is_causal=True)\n",
       "        else:\n",
       "            # Compute attention with memory efficiency\n",
       "            attn_scores = chunked_matmul(q, k.transpose(-2, -1), chunk_size=64) / math.sqrt(self.head_dim)\n",
       "            \n",
       "            # Apply causal mask\n",
       "            seq_len = attn_scores.size(-1)\n",
       "            causal_mask = self.causal_mask[:seq_len, :seq_len]\n",
       "            attn_scores = attn_scores.masked_fill(causal_mask == 0, float('-inf'))\n",
       "            \n",
       "            # Apply ALiBi bias if provided\n",
       "            if alibi_bias is not None:\n",
       "                attn_scores = attn_scores + alibi_bias[:, :, :seq_len]\n",
       "                \n",
       "            # Apply attention mask if provided\n",
       "            if attention_mask is not None:\n",
       "                extended_mask = attention_mask.unsqueeze(1).unsqueeze(2)\n",
       "                attn_scores = attn_scores.masked_fill(extended_mask == 0, float('-inf'))\n",
       "                \n",
       "            attn_weights = F.softmax(attn_scores, dim=-1)\n",
       "            attn_weights = self.dropout(attn_weights)\n",
       "            attn_output = torch.matmul(attn_weights, v)\n",
       "        \n",
       "        # Combine heads and project output\n",
       "        attn_output = attn_output.transpose(1, 2).contiguous().view(B, T, C)\n",
       "        output = self.out_proj(attn_output)\n",
       "        return self.dropout(output)\n",
       "    \n",
       "    def reset_cache(self):\n",
       "        \"\"\"Reset the KV cache\"\"\"\n",
       "        if self.kv_cache is not None:\n",
       "            self.kv_cache.reset()\n",
       "\n",
       "# --- RWKV-style Linear Attention --- #\n",
       "class RWKVAttention(nn.Module):\n",
       "    def __init__(self, config: GPTConfig):\n",
       "        super().__init__()\n",
       "        self.n_embd = config.n_embd\n",
       "        \n",
       "        # Time mixing parameters\n",
       "        self.time_decay = nn.Parameter(torch.ones(config.n_embd))\n",
       "        self.time_first = nn.Parameter(torch.ones(config.n_embd))\n",
       "        \n",
       "        # Key/value projections\n",
       "        self.key = nn.Linear(config.n_embd, config.n_embd, bias=False)\n",
       "        self.value = nn.Linear(config.n_embd, config.n_embd, bias=False)\n",
       "        self.receptance = nn.Linear(config.n_embd, config.n_embd, bias=False)\n",
       "        self.output = nn.Linear(config.n_embd, config.n_embd, bias=False)\n",
       "        \n",
       "        # Saved states for recurrent processing\n",
       "        self.register_buffer('state_a', torch.zeros(1, config.n_embd))\n",
       "        self.register_buffer('state_b', torch.zeros(1, config.n_embd))\n",
       "        self.register_buffer('state_p', torch.zeros(1, config.n_embd))\n",
       "        \n",
       "    def forward(self, x: torch.Tensor) -> torch.Tensor:\n",
       "        B, T, C = x.shape\n",
       "        \n",
       "        # Compute key, value, and receptance\n",
       "        k = self.key(x)\n",
       "        v = self.value(x)\n",
       "        r = self.receptance(x)\n",
       "        \n",
       "        # Initialize state tensors to batch size\n",
       "        if self.state_a.size(0) == 1 and B > 1:\n",
       "            self.state_a = self.state_a.expand(B, -1).clone()\n",
       "            self.state_b = self.state_b.expand(B, -1).clone()\n",
       "            self.state_p = self.state_p.expand(B, -1).clone()\n",
       "        \n",
       "        # Prepare time_decay for stable softmax\n",
       "        time_decay = -torch.exp(self.time_decay)\n",
       "        \n",
       "        outputs = []\n",
       "        \n",
       "        # Process sequence\n",
       "        for t in range(T):\n",
       "            # Update decaying average for keys and values\n",
       "            p = torch.maximum(self.state_p, k[:, t])\n",
       "            wkv = (torch.exp(k[:, t] - p) * v[:, t] +\n",
       "                   torch.exp(self.state_p + self.state_a - p) * self.state_b)\n",
       "            \n",
       "            # Update states\n",
       "            self.state_a = time_decay + self.state_a\n",
       "            self.state_b = torch.exp(self.state_a) * self.state_b + torch.exp(k[:, t]) * v[:, t]\n",
       "            self.state_p = p\n",
       "            \n",
       "            # Apply receptance gating\n",
       "            y = torch.sigmoid(r[:, t]) * wkv\n",
       "            outputs.append(y)\n",
       "        \n",
       "        # Stack outputs and project\n",
       "        output = torch.stack(outputs, dim=1)\n",
       "        return self.output(output)\n",
       "    \n",
       "    def reset_state(self):\n",
       "        \"\"\"Reset the recurrent state\"\"\"\n",
       "        self.state_a.zero_()\n",
       "        self.state_b.zero_()\n",
       "        self.state_p.zero_()"
      ]
     },
