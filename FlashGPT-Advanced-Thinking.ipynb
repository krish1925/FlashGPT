       "## State Space Model (Mamba-style)\n",
       "\n",
       "This implements a selective state space model (SSM) inspired by the Mamba architecture, which offers linear-time sequence processing with adaptive, data-dependent parameters. SSMs work particularly well for capturing long-range dependencies without the quadratic cost of attention."
      ]
     },
     {
      "cell_type": "code",
      "execution_count": null,
      "id": "ssm-implementation",
      "metadata": {},
      "outputs": [],
      "source": [
       "# --- State Space Model (Mamba-style) --- #\n",
       "class SelectiveSSM(nn.Module):\n",
       "    def __init__(self, hidden_dim, ssm_dim=16, dt_min=0.001, dt_max=0.1):\n",
       "        super().__init__()\n",
       "        self.hidden_dim = hidden_dim\n",
       "        self.ssm_dim = ssm_dim\n",
       "        \n",
       "        # Parameters for the SSM\n",
       "        self.A = nn.Parameter(torch.randn(ssm_dim, ssm_dim))\n",
       "        self.B = nn.Parameter(torch.randn(ssm_dim, 1))\n",
       "        self.C = nn.Parameter(torch.randn(1, ssm_dim))\n",
       "        \n",
       "        # Input and output projections\n",
       "        self.in_proj = nn.Linear(hidden_dim, ssm_dim)\n",
       "        self.out_proj = nn.Linear(ssm_dim, hidden_dim)\n",
       "        \n",
       "        # Data-dependent parameter selection\n",
       "        self.dt_proj = nn.Linear(hidden_dim, ssm_dim)\n",
       "        self.register_buffer(\"dt_min\", torch.tensor(dt_min))\n",
       "        self.register_buffer(\"dt_max\", torch.tensor(dt_max))\n",
       "        \n",
       "    def forward(self, x):\n",
       "        B, T, D = x.shape\n",
       "        \n",
       "        # Project input\n",
       "        u = self.in_proj(x)  # [B, T, ssm_dim]\n",
       "        \n",
       "        # Compute data-dependent discretization step size\n",
       "        dt = torch.sigmoid(self.dt_proj(x)) * (self.dt_max - self.dt_min) + self.dt_min\n",
       "        \n",
       "        # Discretize A and B (simplified for implementation)\n",
       "        # For stability in discretization, we use the ZOH (Zero-Order Hold) method\n",
       "        I = torch.eye(self.ssm_dim, device=x.device)\n",
       "        A_discrete = torch.matrix_exp(self.A * dt.unsqueeze(-1))\n",
       "        \n",
       "        # Simplified B discretization for computational efficiency\n",
       "        B_discrete = torch.einsum('bts,sd->btd', dt.unsqueeze(-1), self.B)\n",
       "        \n",
       "        # Initialize state\n",
       "        h = torch.zeros(B, self.ssm_dim, device=x.device)\n",
       "        outputs = []\n",
       "        \n",
       "        # Run SSM recurrence\n",
       "        for t in range(T):\n",
       "            # Update state with current input and previous state\n",
       "            h = torch.bmm(h.unsqueeze(1), A_discrete[:, t]) + u[:, t].unsqueeze(1) * B_discrete[:, t]\n",
       "            h = h.squeeze(1)\n",
       "            # Compute output\n",
       "            y = torch.matmul(h, self.C.t())\n",
       "            outputs.append(y)\n",
       "            \n",
       "        # Combine outputs and project\n",
       "        output = torch.stack(outputs, dim=1).squeeze(-1)\n",
       "        return self.out_proj(output)"
      ]
     },
