      "source": [
       "## Modern Positional Embeddings\n",
       "\n",
       "Rotary Position Embeddings (RoPE) implement advanced relative positional encoding that embeds position information directly into the attention mechanism. This enables better relative position reasoning and enhances extrapolation to longer contexts."
      ]
     },
     {
      "cell_type": "code",
      "execution_count": null,
      "id": "rotary-embeddings",
      "metadata": {},
      "outputs": [],
      "source": [
       "# --- Rotary Position Embeddings (RoPE) --- #\n",
       "class RotaryPositionEmbeddings(nn.Module):\n",
       "    def __init__(self, dim, max_seq_len=2048, base=10000):\n",
       "        super().__init__()\n",
       "        self.dim = dim\n",
       "        self.max_seq_len = max_seq_len\n",
       "        self.base = base\n",
       "        \n",
       "        # Initialize frequency caches\n",
       "        inv_freq = 1.0 / (base ** (torch.arange(0, dim, 2).float() / dim))\n",
       "        self.register_buffer(\"inv_freq\", inv_freq)\n",
       "        \n",
       "        # Cache for faster inference\n",
       "        self._build_cache()\n",
       "        \n",
       "    def _build_cache(self):\n",
       "        t = torch.arange(self.max_seq_len, device=self.inv_freq.device)\n",
       "        freqs = torch.outer(t, self.inv_freq)\n",
       "        emb = torch.cat((freqs, freqs), dim=-1)\n",
       "        \n",
       "        # Cache sin and cos values\n",
       "        self.register_buffer(\"cos_cached\", emb.cos().to(self.inv_freq.dtype), persistent=False)\n",
       "        self.register_buffer(\"sin_cached\", emb.sin().to(self.inv_freq.dtype), persistent=False)\n",
       "        \n",
       "    def _rotate_half(self, x):\n",
       "        \"\"\"Rotates half the hidden dims of the input.\"\"\"\n",
       "        x1, x2 = x.chunk(2, dim=-1)\n",
       "        return torch.cat((-x2, x1), dim=-1)\n",
       "    \n",
       "    def forward(self, q, k, seq_len=None):\n",
       "        if seq_len is None:\n",
       "            seq_len = q.shape[1]  # [batch, seq_len, head_dim]\n",
       "            \n",
       "        # Get cached values or compute for longer sequences\n",
       "        if seq_len <= self.max_seq_len:\n",
       "            cos = self.cos_cached[:seq_len]\n",
       "            sin = self.sin_cached[:seq_len]\n",
       "        else:\n",
       "            # For sequences longer than cached values\n",
       "            t = torch.arange(seq_len, device=self.inv_freq.device)\n",
       "            freqs = torch.outer(t, self.inv_freq)\n",
       "            emb = torch.cat((freqs, freqs), dim=-1)\n",
       "            cos = emb.cos().to(self.inv_freq.dtype)\n",
       "            sin = emb.sin().to(self.inv_freq.dtype)\n",
       "            \n",
       "        # Apply rotary embeddings\n",
       "        q_embed = (q * cos) + (self._rotate_half(q) * sin)\n",
       "        k_embed = (k * cos) + (self._rotate_half(k) * sin)\n",
       "        \n",
       "        return q_embed, k_embed"
      ]
     },
     {
      "cell_type": "markdown",
      "id": "attention-mechanisms-description",
