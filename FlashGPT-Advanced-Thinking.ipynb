       "## Mixture of Experts Layer\n",
       "\n",
       "The Mixture of Experts (MoE) layer implements conditional computation by routing tokens to different specialized expert networks. This enables greater model capacity with the same computational budget, as only a subset of experts process each token."
      ]
     },
     {
      "cell_type": "code",
      "execution_count": null,
      "id": "moe-implementation",
      "metadata": {},
      "outputs": [],
      "source": [
       "# --- Sparse Mixture of Experts --- #\n",
       "class SparseMoE(nn.Module):\n",
       "    def __init__(self, hidden_dim, num_experts=8, top_k=2, capacity_factor=1.5):\n",
       "        super().__init__()\n",
       "        self.hidden_dim = hidden_dim\n",
       "        self.num_experts = num_experts\n",
       "        self.top_k = top_k\n",
       "        self.capacity_factor = capacity_factor\n",
       "        \n",
       "        # Create experts (each is a SwiGLU-like feed-forward network)\n",
       "        self.experts = nn.ModuleList([\n",
       "            nn.Sequential(\n",
       "                nn.Linear(hidden_dim, hidden_dim * 4),\n",
       "                nn.GELU(),\n",
       "                nn.Linear(hidden_dim * 4, hidden_dim)\n",
       "            ) for _ in range(num_experts)\n",
       "        ])\n",
       "        \n",
       "        # Router network\n",
       "        self.router = nn.Linear(hidden_dim, num_experts)\n",
       "        \n",
       "    def forward(self, x):\n",
       "        B, T, D = x.shape\n",
       "        x_flat = x.reshape(-1, D)  # [B*T, D]\n",
       "        \n",
       "        # Calculate routing probabilities\n",
       "        router_logits = self.router(x_flat)  # [B*T, num_experts]\n",
       "        routing_weights, routing_indices = torch.topk(router_logits, self.top_k, dim=-1)\n",
       "        routing_weights = F.softmax(routing_weights, dim=-1)  # [B*T, top_k]\n",
       "        \n",
       "        # Calculate capacity\n",
       "        # Each token is routed to top_k experts\n",
       "        tokens_per_expert = int(self.capacity_factor * B * T * self.top_k / self.num_experts)\n",
       "        \n",
       "        # Create expert outputs\n",
       "        final_output = torch.zeros_like(x_flat)\n",
       "        expert_mask = torch.zeros(B*T, self.num_experts, device=x.device)\n",
       "        \n",
       "        # Assign tokens to experts with capacity constraints\n",
       "        for expert_idx in range(self.num_experts):\n",
       "            # For each expert, find the tokens that route to it across all routing positions\n",
       "            expert_mask_idx = torch.zeros(B*T, device=x.device, dtype=torch.bool)\n",
       "            \n",
       "            for k in range(self.top_k):\n",
       "                # Add tokens that have this expert in their top_k\n",
       "                expert_mask_idx = expert_mask_idx | (routing_indices[:, k] == expert_idx)\n",
       "            \n",
       "            # Get indices of tokens assigned to this expert\n",
       "            indices = torch.where(expert_mask_idx)[0]\n",
       "            \n",
       "            # Apply capacity constraints if needed\n",
       "            if len(indices) > tokens_per_expert:\n",
       "                # Sort indices by routing weight to pick the highest weighted tokens\n",
       "                token_weights = torch.zeros(B*T, device=x.device)\n",
       "                for k in range(self.top_k):\n",
       "                    # Add weights where this expert is a match\n",
       "                    mask = (routing_indices[:, k] == expert_idx)\n",
       "                    token_weights[mask] = routing_weights[:, k][mask]\n",
       "                    \n",
       "                # Keep only top tokens within capacity\n",
       "                expert_indices = indices[token_weights[indices].topk(tokens_per_expert)[1]]\n",
       "            else:\n",
       "                expert_indices = indices\n",
       "            \n",
       "            # Skip if no tokens are routed to this expert\n",
       "            if len(expert_indices) == 0:\n",
       "                continue\n",
       "                \n",
       "            # Create mask for tokens going to this expert\n",
       "            expert_mask_filtered = torch.zeros(B*T, device=x.device, dtype=torch.bool)\n",
       "            expert_mask_filtered[expert_indices] = True\n",
       "            expert_mask[:, expert_idx] = expert_mask_filtered.float()\n",
       "            \n",
       "            # Process tokens with this expert\n",
       "            expert_output = self.experts[expert_idx](x_flat[expert_mask_filtered])\n",
       "            \n",
       "            # Find weights for these tokens across all routing positions\n",
       "            expert_weights = torch.zeros(len(expert_indices), device=x.device)\n",
       "            for k in range(self.top_k):\n",
       "                # Get indices where this expert appears in position k\n",
       "                mask_k = (routing_indices[expert_indices, k] == expert_idx)\n",
       "                # Set weights for those positions\n",
       "                expert_weights[mask_k] = routing_weights[expert_indices, k][mask_k]\n",
       "            \n",
       "            # Apply weighted expert outputs\n",
       "            final_output[expert_indices] += expert_output * expert_weights.unsqueeze(-1)\n",
       "        \n",
       "        # Handle tokens that weren't routed to any expert due to capacity constraints\n",
       "        token_is_routed = (expert_mask.sum(dim=-1) > 0)\n",
       "        if not token_is_routed.all():\n",
       "            # Average all expert outputs for unrouted tokens\n",
       "            mean_output = torch.stack([expert(x_flat[~token_is_routed]) for expert in self.experts]).mean(dim=0)\n",
       "            final_output[~token_is_routed] = mean_output\n",
       "            \n",
       "        return final_output.reshape(B, T, D)"
      ]
     },
