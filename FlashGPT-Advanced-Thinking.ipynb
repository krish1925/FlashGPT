       "# --- Reasoning Tracker --- #\n",
       "class ReasoningTracker(nn.Module):\n",
       "    def __init__(self, hidden_dim, reasoning_steps=3):\n",
       "        super().__init__()\n",
       "        self.hidden_dim = hidden_dim\n",
       "        self.reasoning_steps = reasoning_steps\n",
       "        self.state_tracker = nn.GRU(hidden_dim, hidden_dim, batch_first=True)\n",
       "        self.step_tokenizer = nn.Linear(hidden_dim, hidden_dim)\n",
       "        self.confidence_predictor = nn.Linear(hidden_dim, 1)\n",
       "    \n",
       "    def forward(self, hidden_states):\n",
       "        B, T, C = hidden_states.size()\n",
       "        \n",
       "        # Initialize reasoning state\n",
       "        reasoning_state = torch.zeros(1, B, C, device=hidden_states.device)\n",
       "        all_confidence_scores = []\n",
       "        refined_states = hidden_states\n",
       "        \n",
       "        # Iteratively refine through reasoning steps\n",
       "        for step in range(self.reasoning_steps):\n",
       "            # Process sequence with current reasoning state\n",
       "            output, reasoning_state = self.state_tracker(refined_states, reasoning_state)\n",
       "            \n",
       "            # Generate a \"thinking token\" for this step\n",
       "            thinking_token = self.step_tokenizer(reasoning_state.transpose(0, 1))\n",
       "            \n",
       "            # Assess confidence in current reasoning\n",
       "            confidence = torch.sigmoid(self.confidence_predictor(reasoning_state.transpose(0, 1)))\n",
       "            all_confidence_scores.append(confidence)\n",
       "            \n",
       "            # Use thinking token to refine the representation\n",
       "            refined_states = refined_states + thinking_token\n",
       "        \n",
       "        # Return final refined states and confidence progression\n",
       "        return refined_states, torch.cat(all_confidence_scores, dim=1)\n",
       "\n",
       "# --- Tree of Thought Reasoning --- #\n",
       "class TreeOfThought(nn.Module):\n",
       "    def __init__(self, model, tokenizer=None, num_branches=3, max_depth=3):\n",
       "        super().__init__()\n",
       "        self.model = model\n",
       "        self.tokenizer = tokenizer\n",
       "        self.num_branches = num_branches\n",
       "        self.max_depth = max_depth\n",
       "        self.value_head = nn.Linear(model.gpt_lm_head.transformer.config.n_embd, 1)\n",
       "        \n",
       "    def expand_node(self, input_ids, attention_mask, temperature=0.8):\n",
       "        with torch.no_grad():\n",
       "            outputs = self.model(input_ids=input_ids, attention_mask=attention_mask)\n",
       "            logits = outputs[\"logits\"][:, -1, :] / temperature\n",
       "            probs = F.softmax(logits, dim=-1)\n",
       "            \n",
       "            # Sample multiple tokens to create branches\n",
       "            next_tokens = torch.multinomial(probs, num_samples=self.num_branches, replacement=False)\n",
       "            \n",
       "            # Create new branches by appending tokens\n",
       "            branches = []\n",
       "            for i in range(self.num_branches):\n",
       "                branch_ids = torch.cat([input_ids, next_tokens[:, i:i+1]], dim=1)\n",
       "                branch_mask = torch.cat([attention_mask, torch.ones_like(next_tokens[:, i:i+1])], dim=1)\n",
       "                branches.append((branch_ids, branch_mask))\n",
       "            \n",
       "            # Evaluate value of each branch\n",
       "            values = []\n",
       "            for branch_ids, branch_mask in branches:\n",
       "                hidden_states = self.model.gpt_lm_head.transformer(branch_ids, attention_mask=branch_mask)\n",
       "                value = self.value_head(hidden_states[:, -1]).item()\n",
       "                values.append(value)\n",
       "                \n",
       "            return branches, values\n",
       "    \n",
       "    def search(self, input_ids, attention_mask, beam_size=2):\n",
       "        current_nodes = [(input_ids, attention_mask, [], 0.0)]  # (ids, mask, path, value)\n",
       "        \n",
       "        for depth in range(self.max_depth):\n",
       "            all_branches = []\n",
       "            \n",
       "            for node_ids, node_mask, path, value in current_nodes:\n",
       "                branches, branch_values = self.expand_node(node_ids, node_mask)\n",
       "                \n",
       "                for i, ((branch_ids, branch_mask), branch_value) in enumerate(zip(branches, branch_values)):\n",
       "                    token = branch_ids[0, -1].item()\n",
       "                    new_path = path + [token]\n",
       "                    new_value = value + branch_value\n",
       "                    all_branches.append((branch_ids, branch_mask, new_path, new_value))\n",
       "            \n",
       "            # Select top-k branches for the next iteration\n",
       "            all_branches.sort(key=lambda x: x[3], reverse=True)\n",
       "            current_nodes = all_branches[:beam_size]\n",
       "        \n",
       "        # Return the best path\n",
       "        best_node = max(current_nodes, key=lambda x: x[3])\n",
       "        return best_node[2]  # Return the path of tokens\n",
       "\n",
       "# --- Algorithmic Reasoner --- #\n",
       "class AlgorithmicReasoner(nn.Module):\n",
       "    def __init__(self, hidden_dim, num_registers=4, max_steps=10):\n",
       "        super().__init__()\n",
       "        self.hidden_dim = hidden_dim\n",
       "        self.num_registers = num_registers\n",
       "        self.max_steps = max_steps\n",
       "        \n",
       "        # Register memory\n",
       "        self.register_init = nn.Parameter(torch.randn(1, num_registers, hidden_dim))\n",
       "        \n",
       "        # Operations\n",
       "        self.operation_net = nn.Linear(hidden_dim, hidden_dim * 3)\n",
       "        self.register_select = nn.Linear(hidden_dim, num_registers * 2)\n",
       "        \n",
       "        # Halt controller\n",
       "        self.halt_predictor = nn.Linear(hidden_dim * (num_registers + 1), 1)\n",
       "        \n",
       "    def forward(self, hidden_states):\n",
       "        B, T, C = hidden_states.size()\n",
       "        \n",
       "        # Use the last token's representation as the program\n",
       "        program = hidden_states[:, -1, :]\n",
       "        \n",
       "        # Initialize registers\n",
       "        registers = self.register_init.expand(B, self.num_registers, self.hidden_dim)\n",
       "        \n",
       "        # Step-by-step execution\n",
       "        halted = torch.zeros(B, 1, device=hidden_states.device).bool()\n",
       "        all_register_states = []\n",
       "        \n",
       "        for step in range(self.max_steps):\n",
       "            if halted.all():\n",
       "                break\n",
       "                \n",
       "            # Select registers to operate on\n",
       "            register_scores = self.register_select(program)\n",
       "            reg_a_scores, reg_b_scores = register_scores.chunk(2, dim=1)\n",
       "            reg_a_idx = torch.argmax(reg_a_scores, dim=1)\n",
       "            reg_b_idx = torch.argmax(reg_b_scores, dim=1)\n",
       "            \n",
       "            # Get register values\n",
       "            reg_a = registers[torch.arange(B), reg_a_idx]\n",
       "            reg_b = registers[torch.arange(B), reg_b_idx]\n",
       "            \n",
       "            # Compute operation\n",
       "            op_weights = self.operation_net(program)\n",
       "            op_add, op_mul, op_transform = op_weights.chunk(3, dim=1)\n",
       "            \n",
       "            # Apply operations\n",
       "            result = op_add.unsqueeze(1) * (reg_a.unsqueeze(1) + reg_b.unsqueeze(1)) + \\\n",
       "                     op_mul.unsqueeze(1) * (reg_a.unsqueeze(1) * reg_b.unsqueeze(1)) + \\\n",
       "                     op_transform.unsqueeze(1) * torch.tanh(reg_a.unsqueeze(1))\n",
       "            \n",
       "            # Update register (using reg_a as destination)\n",
       "            registers = registers.scatter(1, reg_a_idx.unsqueeze(1).unsqueeze(2).expand(-1, -1, self.hidden_dim), result)\n",
       "            \n",
       "            # Save register state\n",
       "            all_register_states.append(registers.clone())\n",
       "            \n",
       "            # Check if computation should halt\n",
       "            halt_input = torch.cat([program, registers.view(B, -1)], dim=1)\n",
       "            halt_prob = torch.sigmoid(self.halt_predictor(halt_input))\n",
       "            halted = halted | (halt_prob > 0.5)\n",
       "        \n",
       "        # Return the final register state (as the computation result)\n",
       "        return registers, all_register_states\n",
       "\n",
       "# --- Calculator Tool --- #\n",
       "class CalculatorTool:\n",
       "    \"\"\"\n",
       "    A lightweight symbolic math calculator using sympy.\n",
       "    This tool enables the model to perform inbuilt mathematical evaluations and simplifications.\n",
       "    \"\"\"\n",
       "    def __init__(self):\n",
       "        pass\n",
       "\n",
       "    def calculate(self, expression: str, return_steps: bool = False) -> dict:\n",
       "        \"\"\"\n",
       "        Evaluates a mathematical expression using sympy.\n",
       "        \n",
       "        Args:\n",
       "            expression: A string containing the mathematical expression\n",
       "            return_steps: If True, returns intermediate simplification steps\n",
       "            \n",
       "        Returns:\n",
       "            A dict with 'result' and optionally 'steps' (list of intermediate expressions)\n",
       "        \"\"\"\n",
       "        try:\n",
       "            expr = sp.sympify(expression)\n",
       "            steps = []\n",
       "            \n",
       "            if return_steps:\n",
       "                # Break down the expression into simpler steps\n",
       "                steps.append(f\"Original expression: {expr}\")\n",
       "                simplified = expr\n",
       "                \n",
       "                if expr.has(sp.Add):\n",
       "                    # Expand addition terms\n",
       "                    terms = expr.as_ordered_terms()\n",
       "                    steps.append(f\"Decomposed terms: {terms}\")\n",
       "                    \n",
       "                if expr.has(sp.Mul):\n",
       "                    # Factor or expand multiplications\n",
       "                    factored = sp.factor(expr)\n",
       "                    steps.append(f\"Factored form: {factored}\")\n",
       "                    simplified = factored\n",
       "                    \n",
       "                # Add simplification rules for exponents, logarithms, etc.\n",
       "                if expr.has(sp.Pow):\n",
       "                    steps.append(f\"Expression with powers: {sp.powsimp(expr)}\")\n",
       "                    \n",
       "                if expr.has(sp.log):\n",
       "                    steps.append(f\"Expression with logarithms: {sp.logcombine(expr)}\")\n",
       "                    \n",
       "                # Final simplified form\n",
       "                steps.append(f\"Simplified: {sp.nsimplify(simplified)}\")\n",
       "                \n",
       "            result = sp.nsimplify(expr)\n",
       "            return {\"result\": str(result), \"steps\": steps if return_steps else None}\n",
       "        except Exception as e:\n",
       "            return {\"result\": f\"Error: {e}\", \"steps\": None}"
      ]
     },
